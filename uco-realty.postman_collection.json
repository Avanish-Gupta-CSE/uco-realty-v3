{
  "info": {
    "name": "UCO Realty - public API",
    "description": "Read-only customer API of uco-realty-public (no login). Staff features use the browser session through bank SSO and are not part of this collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "projectId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "List approved projects",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/public/projects?state=&city=&search=&page=0&size=8",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "public",
            "projects"
          ],
          "query": [
            {
              "key": "state",
              "value": ""
            },
            {
              "key": "city",
              "value": ""
            },
            {
              "key": "search",
              "value": ""
            },
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "8"
            }
          ]
        }
      }
    },
    {
      "name": "Meta (states and cities that have projects)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/public/meta",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "public",
            "meta"
          ]
        }
      }
    },
    {
      "name": "Project detail",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/public/projects/{{projectId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "public",
            "projects",
            "{{projectId}}"
          ]
        }
      }
    },
    {
      "name": "Create lead (interest in a project)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test Customer\",\n  \"phone\": \"9876543210\",\n  \"projectId\": \"{{projectId}}\",\n  \"status\": \"SUCCESSFUL_APPLIED\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/public/leads",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "public",
            "leads"
          ]
        }
      }
    },
    {
      "name": "Create lead (visitor, no project)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test Visitor\",\n  \"phone\": \"9876543211\",\n  \"status\": \"VISITOR\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/public/leads",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "public",
            "leads"
          ]
        }
      }
    }
  ]
}