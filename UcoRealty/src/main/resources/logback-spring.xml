<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Log folder is fixed on purpose: this is where the UAT / production server keeps application logs (drive E:). On a laptop it just creates an "E:" folder in the directory you started Java from.
         Every start of the application opens a NEW file named with the start date and time, e.g. UcoRealty-2026-11-18_14-35-52.log.
         That file is closed and compressed to UcoRealty-yyyy-MM-dd.<n>.log.gz when the day changes or it reaches 50 MB; those archives are kept 30 days (3 GB at most) and then deleted. -->
    <timestamp key="startTime" datePattern="yyyy-MM-dd_HH-mm-ss"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>E:/Realty/UcoRealty/logs/UcoRealty-${startTime}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>E:/Realty/UcoRealty/logs/UcoRealty-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level [UCO-CUSTOMER] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.ucorealty" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>
</configuration>

